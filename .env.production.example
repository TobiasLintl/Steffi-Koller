# Production settings for docker-compose.prod.yml – copy to .env.production on the server.
# Never commit the real file. Generate secrets with: openssl rand -base64 32

COMPOSE_PROJECT_NAME=seelenzeit
SITE_DOMAIN=www.seelenzeit.de
REDIRECT_DOMAIN=seelenzeit.de
ACME_EMAIL=info@seelenzeit.de
NEXT_PUBLIC_APP_URL=https://www.seelenzeit.de

POSTGRES_USER=seelenzeit
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=seelenzeit
DATABASE_URL=postgres://seelenzeit:CHANGE-ME@db:5432/seelenzeit

BETTER_AUTH_SECRET=CHANGE-ME
AUTH_RATE_LIMIT=on

MAIL_DRIVER=brevo
NEWSLETTER_DRIVER=brevo
BREVO_API_KEY=
BREVO_NEWSLETTER_LIST_ID=
MAIL_FROM_SUPPORT=kundenservice@seelenzeit.de
MAIL_FROM_NEWSLETTER=newsletter@seelenzeit.de
ADMIN_NOTIFICATION_EMAIL=info@seelenzeit.de

COPECART_WEBHOOK_SECRET=
DIGISTORE24_IPN_PASSPHRASE=

STORAGE_DRIVER=s3
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_REGION=eu-central
S3_BUCKET=seelenzeit-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_URL_TTL_SECONDS=600

VIDEO_DRIVER=bunny
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_TOKEN_KEY=
VIDEO_TOKEN_TTL_SECONDS=3600

BACKUP_STORAGE_DRIVER=s3
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=seelenzeit-backups
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_ENCRYPTION_KEY=CHANGE-ME
BACKUP_RETENTION_DAYS=30

# Staging only (with CADDYFILE=./deploy/Caddyfile.staging):
# STAGING_USER=seelenzeit
# STAGING_PASSWORD_HASH=
