# Copy to .env and adjust. Never commit .env.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional privacy-friendly statistics (e.g. Plausible/Matomo); loaded only after consent.
# NEXT_PUBLIC_STATISTICS_SCRIPT_URL=
# NEXT_PUBLIC_STATISTICS_DOMAIN=

# --- Database (docker-compose.yml) ---
POSTGRES_USER=seelenzeit
POSTGRES_PASSWORD=seelenzeit
POSTGRES_DB=seelenzeit
POSTGRES_PORT=5432
DATABASE_URL=postgres://seelenzeit:seelenzeit@localhost:5432/seelenzeit

# --- Auth ---
# Generate with: openssl rand -base64 32  (required in production)
BETTER_AUTH_SECRET=dev-only-secret-change-me-dev-only-secret
AUTH_RATE_LIMIT=on

# --- Payment / Reseller (D-02) ---
# Webhook URLs: https://<domain>/api/webhooks/copecart and /api/webhooks/digistore24
COPECART_WEBHOOK_SECRET=
DIGISTORE24_IPN_PASSPHRASE=
# Receives notifications about refunds, failed webhooks etc. (optional)
ADMIN_NOTIFICATION_EMAIL=

# --- Video (D-04) ---
# local = dev only (file from storage, no transcoding); bunny = production
VIDEO_DRIVER=local
# BUNNY_STREAM_LIBRARY_ID=
# BUNNY_STREAM_API_KEY=
# Library → Security → "Token Authentication Key"; also enable token auth + allowed referrers
# BUNNY_STREAM_TOKEN_KEY=
VIDEO_TOKEN_TTL_SECONDS=3600

# --- Object storage for PDFs/audio (private bucket) ---
# local = dev only (./var/storage); s3 = e.g. Hetzner Object Storage
STORAGE_DRIVER=local
# S3_ENDPOINT=https://fsn1.your-objectstorage.com
# S3_REGION=eu-central
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
MEDIA_URL_TTL_SECONDS=600

# --- Mail / Newsletter (D-05) ---
# log = print mails to the server log (dev); brevo = send via Brevo API
MAIL_DRIVER=log
NEWSLETTER_DRIVER=log
# BREVO_API_KEY=
# BREVO_NEWSLETTER_LIST_ID=
MAIL_FROM_SUPPORT=kundenservice@seelenzeit.de
MAIL_FROM_NEWSLETTER=newsletter@seelenzeit.de

# --- Backups (nightly, encrypted, external storage) ---
# local = ./var/backups (dev only); s3 = separate bucket, ideally another provider/region
BACKUP_STORAGE_DRIVER=local
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_REGION=eu-central
# BACKUP_S3_BUCKET=
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# Generate with: openssl rand -base64 32 – store it additionally OUTSIDE the server (password manager)!
BACKUP_ENCRYPTION_KEY=dev-only-backup-key-change-me
BACKUP_RETENTION_DAYS=30
